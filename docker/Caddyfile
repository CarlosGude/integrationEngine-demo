{
	admin off
}

:80 {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				common_log delete
				request>headers>User-Agent delete
			}
		}
	}

	encode gzip

	root * /app/public
	file_server

	php_fastcgi 127.0.0.1:9000 {
		env SCRIPT_FILENAME {http.request.uri.path}
		env PATH_INFO {http.request.uri.path}
	}

	try_files {path} /index.php?{query}
}
