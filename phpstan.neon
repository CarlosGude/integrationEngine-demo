parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - var/
            - vendor/
            # The "before" exhibit of the tour: a deliberately untyped god class.
            # Typing it would change the snippet the tour shows as the antipattern.
            - src/Legacy/
        analyseAndScan:
            - var/
            - vendor/
    errorFormat: table
    reportUnmatchedIgnoredErrors: true
