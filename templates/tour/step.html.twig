{% extends "base.html.twig" %}

{% block title %}{{ step.title }} - Tour{% endblock %}

{% block body %}
<div class="tour-container">
    <h2>{{ step.title }}</h2>
    <p>{{ step.description }}</p>

    <div class="tour-nav">
        {% if previousStep %}
            <a href="{{ path('tour_step', {'stepId': previousStep.id}) }}" class="btn-prev">← Previous</a>
        {% endif %}
        {% if nextStep %}
            <a href="{{ path('tour_step', {'stepId': nextStep.id}) }}" class="btn-next">Next →</a>
        {% endif %}
    </div>

    {% set liveStep = step.id in ['the-problem', 'parallel-requests', 'behind-the-counter', 'renting-a-movie'] %}
    {% set simulatedEvent = step.id == 'payment-confirmation' %}
    <p class="execution-mode">
        {% if simulatedEvent %}
            {{ app.request.locale == 'es'
                ? 'Evento tipado simulado: no se recibe un webhook de Stripe en este paso.'
                : 'Simulated typed event: this step does not receive a Stripe webhook.' }}
        {% elseif liveStep %}
            {{ app.request.locale == 'es'
                ? 'Llamada real: requiere el proveedor y sus credenciales cuando corresponda.'
                : 'Live call: requires the provider and credentials where applicable.' }}
        {% else %}
            {{ app.request.locale == 'es'
                ? 'Escenario determinista: muestra el patrón sin conectarlo al tráfico real.'
                : 'Deterministic scenario: illustrates the pattern without wiring it into live traffic.' }}
        {% endif %}
    </p>
    <button id="run-btn" class="btn-run">Run Step</button>

    <div id="trace" class="trace-output" style="display: none;">
        <h3>Result</h3>
        <pre id="result-output"></pre>
        <h3>Execution Trace</h3>
        <ul id="trace-list"></ul>
        <p>Total: <span id="total-duration">0</span>ms</p>
    </div>
</div>

<style>
    .tour-container { max-width: 800px; margin: 2rem auto; padding: 1rem; }
    .tour-nav { margin: 2rem 0; display: flex; gap: 1rem; }
    .btn-run { padding: 0.5rem 1.5rem; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .btn-run:hover { background: #0056b3; }
    .execution-mode { padding: 0.6rem 0.8rem; border-left: 3px solid #007bff; background: #f3f7fb; }
    .btn-prev, .btn-next { padding: 0.5rem 1rem; text-decoration: none; background: #f0f0f0; border-radius: 4px; }
    .trace-output { margin-top: 2rem; padding: 1rem; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px; }
    #trace-list { list-style: none; padding: 0; }
    #trace-list li { padding: 0.5rem 0; border-bottom: 1px solid #eee; }
</style>

<script>
    document.getElementById('run-btn').addEventListener('click', async () => {
        const response = await fetch('{{ path('tour_run', {'stepId': step.id}) }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        document.getElementById('result-output').textContent = JSON.stringify(data.result, null, 2);
        displayTrace(data.trace);
    });

    function displayTrace(trace) {
        const list = document.getElementById('trace-list');
        list.innerHTML = '';
        trace.calls.forEach(call => {
            const li = document.createElement('li');
            li.textContent = `${call.action} → ${call.method} (${call.status}) ${call.duration_ms}ms`;
            list.appendChild(li);
        });
        document.getElementById('total-duration').textContent = trace.total_duration_ms.toFixed(2);
        document.getElementById('trace').style.display = 'block';
    }
</script>
{% endblock %}
