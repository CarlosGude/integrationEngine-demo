parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Catalog\\Application\\MovieCatalogGateway\:\:getMoviesByIdBatch\(\) should return array\<int, App\\Catalog\\Domain\\Movie\|null\> but returns array\<App\\Catalog\\Domain\\Movie\|null\>\.$#'
			identifier: return.type
			count: 1
			path: src/Catalog/Application/MovieCatalogGateway.php

		-
			message: '#^Cannot access offset ''timestamp'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Command/MercurePublishCommand.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 2
			path: src/Command/MercurePublishCommand.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: src/Command/MercurePublishCommand.php

		-
			message: '#^Parameter \#1 \.\.\.\$arg1 of function max expects non\-empty\-array, list\<float\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Console/BenchmarkCommand.php

		-
			message: '#^Parameter \#1 \.\.\.\$arg1 of function min expects non\-empty\-array, list\<float\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Console/BenchmarkCommand.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 2
			path: src/Console/SimulateRentalCommand.php

		-
			message: '#^Cannot access offset ''amount'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''currency'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''data'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 3
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''message'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''object'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 3
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''topic'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot access offset ''type'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Parameter \$data of class Symfony\\Component\\Mercure\\Update constructor expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/Controller/MercureUpdateController.php

		-
			message: '#^Method App\\Integrations\\Countries\\GetCountries\\GetCountriesAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Countries/GetCountries/GetCountriesAction.php

		-
			message: '#^Method App\\Integrations\\Stripe\\CreatePaymentIntent\\CreatePaymentIntentAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Stripe/CreatePaymentIntent/CreatePaymentIntentAction.php

		-
			message: '#^Method App\\Integrations\\Supplier\\GetPrices\\GetPricesAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Supplier/GetPrices/GetPricesAction.php

		-
			message: '#^Parameter \#1 \$prices of class App\\Integrations\\Supplier\\GetPrices\\GetPricesResponse constructor expects list\<array\<string, string\>\>, array\<array\<string, string\>\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Integrations/Supplier/Mappers/GetPricesMapper.php

		-
			message: '#^Method App\\Integrations\\Tmdb\\GetConfiguration\\GetConfigurationAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Tmdb/GetConfiguration/GetConfigurationAction.php

		-
			message: '#^Method App\\Integrations\\Tmdb\\GetMovie\\GetMovieAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Tmdb/GetMovie/GetMovieAction.php

		-
			message: '#^Method App\\Integrations\\Tmdb\\GetTvSeason\\GetTvSeasonAction\:\:mapper\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Integrations/Tmdb/GetTvSeason/GetTvSeasonAction.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Kernel.php

		-
			message: '#^Cannot access offset ''all'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Kernel.php

		-
			message: '#^Cannot access offset string on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Kernel.php

		-
			message: '#^Variable \$lastException on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Shared/Infrastructure/Middleware/RetryMiddleware.php

		-
			message: '#^Constant App\\Shared\\Infrastructure\\Resilience\\CircuitBreaker\:\:FAILURE_WINDOW_SEC is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: src/Shared/Infrastructure/Resilience/CircuitBreaker.php

		-
			message: '#^Property App\\Shared\\Infrastructure\\Resilience\\CircuitBreaker\:\:\$successCount is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Shared/Infrastructure/Resilience/CircuitBreaker.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertIsFloat\(\) with float will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Catalog/UI/Console/BenchmarkCommandTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertNull\(\) with null will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 2
			path: tests/Catalog/UI/StorefrontControllerTest.php

		-
			message: '#^Parameter \#2 \$string of static method PHPUnit\\Framework\\Assert\:\:assertStringStartsWith\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Legacy/LegacyEngineParityTest.php

		-
			message: '#^Call to function is_subclass_of\(\) with ''App\\\\Shared\\\\Infrastructure\\\\Middleware\\\\RateLimitMiddleware'' and ''IntegrationEngine\\\\Core\\\\Contract\\\\Client\\\\AbstractClientMiddleware'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: tests/Shared/Infrastructure/Middleware/RateLimitMiddlewareTest.php

		-
			message: '#^Call to function method_exists\(\) with ''App\\\\Shared\\\\Infrastructure\\\\Middleware\\\\RateLimitMiddleware'' and ''process'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: tests/Shared/Infrastructure/Middleware/RateLimitMiddlewareTest.php

		-
			message: '#^Call to function method_exists\(\) with ''App\\\\Shared\\\\Infrastructure\\\\Middleware\\\\RateLimitMiddleware'' and ''processMany'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: tests/Shared/Infrastructure/Middleware/RateLimitMiddlewareTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertTrue\(\) with true will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Shared/Infrastructure/Middleware/RateLimitMiddlewareTest.php

		-
			message: '#^Method Tests\\Translation\\TranslationParityTest\:\:loadMessages\(\) should return array\<string, string\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: tests/Translation/TranslationParityTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertNotNull\(\) with Symfony\\Component\\DependencyInjection\\ContainerInterface will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Unit/KernelBootTest.php
